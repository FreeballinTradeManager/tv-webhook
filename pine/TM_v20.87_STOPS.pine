//   TPOST — {"ticker","action":"buy"/"sell"/"exit"/"cancel", quantity, orderType}
//   TE    — {"event":"ENTRY"/"TP1"/"TP2"/"TP3"/"CLOSE50"/"STOP_HIT"/"EMA_EXIT"/"MASTER_CLOSE"/"STOP_UPDATE"/"CLOSE_FALLBACK", side, ticker, qty, key}
